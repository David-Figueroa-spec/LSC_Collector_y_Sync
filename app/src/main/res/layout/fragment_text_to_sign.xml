<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crema"
    android:padding="16dp">

    <TextView
        android:id="@+id/titleTextToSign"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Texto ➔ Seña"
        android:textColor="@color/texto_oscuro"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/inputEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@android:color/white"
        android:hint="Escribe una palabra o texto..."
        android:inputType="textCapCharacters"
        android:padding="14dp"
        android:textColor="@color/texto_oscuro"
        android:textColorHint="#888888"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleTextToSign" />

    <com.example.lsccollectorsync.ui.texttosign.Hand3DView
        android:id="@+id/hand3DView"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:layout_marginTop="16dp"
        android:background="#222222"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/inputEditText" />

    <HorizontalScrollView
        android:id="@+id/signsScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hand3DView">

        <LinearLayout
            android:id="@+id/signsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp" />
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
